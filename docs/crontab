# These are the cron jobs.
# Adjust PATH according to where the repository is checked out on the filesystem

PATH=$PATH:/var/www/bin

0,15,30,45  *   * * * scheduler >> /tmp/schedule.log
*           *   * * * /usr/bin/indexer -c /etc/manticoresearch/manticore.conf --rotate delta log_delta > /dev/null
5           */2 * * * /usr/bin/indexer -c /etc/manticoresearch/manticore.conf --rotate --all >> /tmp/manticore-indexer.log
