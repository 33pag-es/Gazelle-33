# Copy to .env and replace every value before using docker-compose.prod.yml.
# Docker Compose reads .env automatically; .env is gitignored.

# MySQL
MYSQL_DATABASE=gazelle
MYSQL_USER=gazelle
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_RO_USER=gazro
MYSQL_RO_PASSWORD=change-me
MYSQL_PHINX_USER=gazelle_phinx
MYSQL_PHINX_PASSWORD=change-me

# Tracker server (Ocelot, ../Ocelot/docker-compose.prod.yml) over WireGuard.
# MySQL creates the Ocelot account on first start, allowed to log in only
# from TRACKER_TUNNEL_IP. OCELOT_MYSQL_USER/PASSWORD must match the tracker
# server's .env. TRACKER_SECRET/TRACKER_REPORTKEY live in
# lib/override.config.php and the tracker's .env, not here.
OCELOT_MYSQL_USER=ocelot
OCELOT_MYSQL_PASSWORD=change-me
GAZELLE_TUNNEL_IP=10.33.0.1
TRACKER_TUNNEL_IP=10.33.0.2
# Port on GAZELLE_TUNNEL_IP for Ocelot's freeleech-token callback; must
# match GAZELLE_PORT in the tracker server's .env.
GAZELLE_TUNNEL_PORT=8080

# PostgreSQL
POSTGRES_USER=gazelle_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=gazelle
POSTGRES_DB_USER=gazelle
POSTGRES_USER_PASSWORD=change-me
PG_RO_USER=gazro
PG_RO_PASS=change-me

# Web
# The host reverse proxy (misc/caddy/Caddyfile.example) connects to
# WEB_BIND:WEB_PORT. Keep WEB_PORT off 80/443, which the proxy listens on.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Pinned Docker network. The host proxy reaches the containers from
# GAZELLE_GATEWAY; ALLOWED_PROXY in override.config.php must list it. Change
# the subnet only if it collides with another network on the host, and keep
# the gateway on the last host address (.254 for a /24).
GAZELLE_SUBNET=172.30.33.0/24
GAZELLE_GATEWAY=172.30.33.254

# Path to the filled-in production configuration, relative to this directory
# or absolute.
OVERRIDE_CONFIG=./lib/override.config.php

# Build-time values baked into generated stylesheets. These must agree with
# SITE_HOST/SITE_NAME/SITE_URL/STATIC_SERVER in override.config.php.
SITE_HOST=example.com
SITE_NAME=Gazelle
SITE_URL=https://example.com
STATIC_SERVER=/static
