{# COMIC-ONLY: confirm splitting one issue into a new series. #}
{{ header('Split into new series') }}
<div class="thin">
<div class="header">
    <h2>Confirm split to new series</h2>
</div>
<div class="box pad">
    <form class="confirm_form" name="torrent_group" action="torrents.php" method="post">
        <input type="hidden" name="action" value="newgroup">
        <input type="hidden" name="confirm" value="true">
        <input type="hidden" name="auth" value="{{ viewer.auth }}">
        <input type="hidden" name="torrentid" value="{{ torrent.id }}">
        <input type="hidden" name="title" value="{{ title }}">
        <input type="hidden" name="year" value="{{ year }}">
        <div class="box pad">From {{ torrent.group.link|raw }}:<br><br>
            you plan to split the torrent {{ torrent.id }} {{ torrent.shortLabelLink|raw }}
            to the new series:<br>
            <b>{{ title }} ({{ year }})</b><br><br>
            The new series starts with the publisher, creators and tags of the current series.
        </div>
        <br><br><input type="submit" value="Confirm">
    </form>
</div>
</div>
{{ footer() }}
