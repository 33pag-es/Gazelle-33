{# COMIC-ONLY: comic series torrent table. #}
{% if flash %}
<p class="important_text">{{ flash }}</p>
{% endif %}
<table class="torrent_table details m_table" id="torrent_details">
    <tr class="colhead_dark">
        <td class="m_th_left" width="30%"><strong>Name</strong></td>
        <td><strong>Issue</strong></td>
        <td><strong>Scanner</strong></td>
        <td><strong>Format</strong></td>
        <td><strong>Checked</strong></td>
{% if viewer.ordinal.value('file-count-display') %}
        <td class="number_column"><strong>Files</strong></td>
{% endif %}
        <td class="number_column"><strong>Size</strong></td>
        <td class="m_th_right sign snatches"><img src="{{ url_stem }}snatched.svg" class="tooltip" alt="Snatches" title="Snatches"></td>
        <td class="m_th_right sign seeders"><img src="{{ url_stem }}seeders.svg" class="tooltip" alt="Seeders" title="Seeders"></td>
        <td class="m_th_right sign leechers"><img src="{{ url_stem }}leechers.svg" class="tooltip" alt="Leechers" title="Leechers"></td>
    </tr>
{% for torrent in torrent_list %}
{%  include 'comic/torrent-row.twig' with {'torrent': torrent, 'tgroup': tgroup, 'viewer': viewer} only %}
{% endfor %}
</table>
