{# COMIC-ONLY: the front door says as little as it can: the short mark, one line, the entry links. #}
{{ header(constant('SITE_NAME')) }}
<div id="logo" class="splash-logo">
{% if constant('SHOW_LOGO') %}
<a href="/login.php" style="margin-left: 0;"><img src="{{ constant('STATIC_SERVER') }}/svg/site/33pages-lockup-33p.svg" width="320" height="170" alt="33P" title=""></a>
{% endif %}
</div>
<p class="splash-line">There was never supposed to be a page 33.</p>

<div class="actions">
    <span class="action-bar">
{% if not new %}
    <a href="/login.php">Enter</a>
{% endif %}
{% if new or constant('OPEN_REGISTRATION') %}
    <a title="Obtain an account by supplying a valid email address" href="register.php">Register</a>
{% endif %}
{% if constant('OPEN_EXTERNAL_REFERRALS') %}
    <a title="Obtain an account by proving your membership on a site we trust" href="referral.php">Referral</a>
{% endif %}
{% if constant('RECOVERY') %}
    <a title="Obtain a new account by proving your membership on the previous site" href="recovery.php">Recovery</a>
{% endif %}
    </span>
</div>
{{ footer() }}
