{# COMIC-ONLY #}
{% from 'macro/form.twig' import autocomplete, selected %}
{% set ro = series_locked ? ' readonly' : '' %}
<table id="form-comic-upload" cellpadding="3" cellspacing="1" border="0" class="layout border slice" width="100%">
{% include 'upload/alert.twig' %}
{% if series_locked %}
    <tr>
        <td class="label"></td>
        <td><span class="small">Series details are shared by every issue in this series and can only be changed by staff.
            Changes to the series fields and description here are ignored.</span></td>
    </tr>
{% endif %}
    <tr id="name">
        <td class="label">Series title:</td>
        <td><input type="text" id="title" name="title" size="60" value="{{ torrent.Title }}"{{ ro }}></td>
    </tr>
    <tr>
        <td class="label">Publisher:</td>
        <td><input type="text" id="publisher" name="publisher" size="60" value="{{ torrent.Publisher }}"{{ ro }}></td>
    </tr>
    <tr>
        <td class="label">Creators:</td>
        <td>
            <input type="text" id="creators" name="creators[]" size="60" value="{{ torrent.Creators }}"{{ ro }}>
            <span class="small">Separate multiple creators with commas.</span>
        </td>
    </tr>
    <tr>
        <td class="label">Year:</td>
        <td><input type="number" id="year" name="year" size="5" max="{{ 'now'|date('Y') + 1 }}" value="{{ torrent.Year }}"{{ ro }}></td>
    </tr>
    <tr>
        <td class="label">Issue start:</td>
        <td><input type="number" id="issue_start" name="issue_start" size="8" min="0" max="100000" value="{{ torrent.IssueStart }}"></td>
    </tr>
    <tr>
        <td class="label">Issue end:</td>
        <td><input type="number" id="issue_end" name="issue_end" size="8" min="0" max="100000" value="{{ torrent.IssueEnd }}">
            <span class="small">Leave empty for a single issue.</span></td>
    </tr>
    <tr>
        <td class="label">Issue label:</td>
        <td><input type="text" id="issue_label" name="issue_label" size="32" value="{{ torrent.IssueLabel }}">
            <span class="small">Use for specials, annuals, or any issue without a number.</span></td>
    </tr>
    <tr>
        <td class="label">Scanner:</td>
        <td><input type="text" id="scanner" name="scanner" size="40" value="{{ torrent.Scanner }}"></td>
    </tr>
    <tr>
        <td class="label">Format:</td>
        <td>
            <select id="format" name="format">
{%  for comicFormat in constant('COMIC_FORMAT') %}
                <option value="{{ comicFormat }}"{{ selected(comicFormat == torrent.Format) }}>{{ comicFormat }}</option>
{%  endfor %}
            </select>
        </td>
    </tr>
    <tr>
        <td class="label">Tags:</td>
        <td><input type="text" id="tags" name="tags" size="60" value="{{ torrent.TagList }}"{{ ro }}{{ autocomplete(user, enum('Gazelle\\Enum\\Autocomplete').everywhere) }}></td>
    </tr>
{% include 'upload/cover.twig' with {'is_uploaded': series_locked, 'image': image} only %}
    <tr>
        <td class="label">Description:</td>
        <td>{{ description.emit|raw }}</td>
    </tr>
    <tr>
        <td class="label">Release description:</td>
        <td>{{ release_description.emit|raw }}</td>
    </tr>
</table>
