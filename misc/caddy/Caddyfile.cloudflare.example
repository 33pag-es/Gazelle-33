# COMIC-ONLY: host reverse proxy when Cloudflare proxies the site, but not
# the tracker. Use instead of Caddyfile.example.
#
# Cloudflare DNS:
#   example.com          proxied (orange cloud), SSL/TLS mode "Full (strict)"
#   tracker.example.com  DNS only (grey cloud). Announces must reach Caddy
#                        directly so Ocelot records the peer's own address.
#
# Certificates: the site uses a Cloudflare Origin CA certificate (SSL/TLS >
# Origin Server > Create Certificate), saved to the paths below and readable
# by the caddy user. The tracker host keeps Caddy's automatic certificate.
#
# Client IP: requests from Cloudflare's published ranges are trusted for
# CF-Connecting-IP; any other connection uses its own address, so a client
# that bypasses Cloudflare cannot choose its IP. Every upstream receives a
# single X-Forwarded-For value, which is what Gazelle (ALLOWED_PROXY) and
# Ocelot expect. Refresh the ranges from https://www.cloudflare.com/ips/
# (fetched 2026-11-09).
#
# Upstreams match docker-compose.prod.yml: Gazelle on 127.0.0.1:8080 and the
# Ocelot overlay on 127.0.0.1:34000.
{
	email admin@example.com
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

example.com {
	tls /etc/caddy/cloudflare-origin.pem /etc/caddy/cloudflare-origin.key
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}

tracker.example.com {
	# Expose only announce and scrape. Ocelot's update and report actions use
	# the same /<key>/<action> shape and are for Gazelle's internal calls.
	@tracker path_regexp ^/[A-Za-z0-9]{32}/(announce|scrape)$
	handle @tracker {
		reverse_proxy 127.0.0.1:34000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		respond 404
	}
}
