# COMIC-ONLY: host reverse proxy for the site server when Cloudflare proxies
# the site. Use instead of Caddyfile.example. The tracker has its own server,
# a DNS-only record, and its own Caddyfile (../Ocelot/docker/).
#
# Cloudflare: proxy the site hostname (orange cloud), SSL/TLS mode
# "Full (strict)", Network > IPv6 Compatibility off. Firewall this server's
# port 443 to Cloudflare's ranges (README), and never publish its IP in DNS.
#
# Certificate: a Cloudflare Origin CA certificate (SSL/TLS > Origin Server >
# Create Certificate), saved to the paths below and readable by the caddy
# user. Caddy does not request a public certificate on this server.
#
# Client IP: requests from Cloudflare's published ranges are trusted for
# CF-Connecting-IP; any other connection uses its own address, so a client
# that bypasses Cloudflare cannot choose its IP. Gazelle receives a single
# X-Forwarded-For value, which ALLOWED_PROXY accepts. Refresh the ranges
# from https://www.cloudflare.com/ips/ (fetched 2026-11-09).
#
# docker-compose.prod.yml publishes Gazelle on 127.0.0.1:8080 (WEB_PORT).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

example.com {
	tls /etc/caddy/cloudflare-origin.pem /etc/caddy/cloudflare-origin.key
	# IPv4 only. Also turn off Network > IPv6 Compatibility in Cloudflare so
	# IPv6 visitors are not offered the site at all.
	@not_ipv4 not client_ip 0.0.0.0/0
	respond @not_ipv4 "This site accepts IPv4 connections only." 403
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}
